{
  "name": "novelreaper",
  "productName": "NovelReaper",
  "version": "0.1.0",
  "description": "A calm, local-first EPUB reader for Windows.",
  "main": ".webpack/main",
  "private": true,
  "license": "UNLICENSED",
  "author": "NovelReaper contributors",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "start": "electron-forge start",
    "build": "electron-forge package",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.vite.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:security": "playwright test --config playwright.security.config.ts",
    "web": "vite --config vite.browser.config.mts",
    "web:build": "vite build --config vite.browser.config.mts",
    "web:preview": "vite preview --config vite.browser.config.mts",
    "web:test": "vitest run tests/unit/browser tests/component",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "foliate-js": "https://github.com/johnfactotum/foliate-js/archive/78914aef4466eb960965702401634c2cb348e9b1.tar.gz",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/webpack-env": "1.18.8",
    "@vitejs/plugin-react": "6.1.0",
    "axe-core": "4.13.0",
    "css-loader": "7.1.4",
    "electron": "43.4.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "mini-css-extract-plugin": "2.10.2",
    "prettier": "3.9.6",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2"
  }
}
